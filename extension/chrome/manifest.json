{
  "manifest_version": 3,
  "key": "",
  "name": "SAI Browser Bridge",
  "version": "0.1.0",
  "description": "Lets SAI see the tabs you explicitly attach. Read-only by default; control is a separate per-tab opt-in.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Attach this tab to SAI"
  },
  "icons": {
    "128": "icon128.png"
  }
}
